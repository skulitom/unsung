    "text": "{\n  \"name\": \"explain-it-back\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"workspaces\": [\n    \"apps/*\",\n    \"packages/*\"\n  ],\n  \"scripts\": {\n    \"dev\": \"concurrently -n BACKEND,MOBILE \\\"npm run dev:backend\\\" \\\"npm run dev:mobile\\\"\",\n    \"dev:backend\": \"npm run dev --workspace=@explain-it-back/backend\",\n    \"dev:mobile\": \"npm run start --workspace=@explain-it-back/mobile\",\n    \"typecheck:backend\": \"npm run typecheck --workspace=@explain-it-back/backend\"\n  },\n  \"devDependencies\": {\n    \"concurrently\": \"^10.0.5\"\n  }\n}\n"
